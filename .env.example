# Copy to .env and fill in your values. Never commit .env.

# Server
NODE_ENV=development
PORT=3000

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Frontend (Vite) - used by frontend build
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Google Gemini AI (for price suggestions / Stitch)
GEMINI_API_KEY=AIza...

# SerpAPI (for Google Shopping price lookups)
SERPAPI_KEY=your_serpapi_key

# Optional: Google Maps (for geocoding / maps)
VITE_GOOGLE_MAPS_API_KEY=AIza...

# Stripe (for checkout)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Production: set your domain for CORS
# CORS_ORIGIN=https://yourdomain.com
# ALLOWED_ORIGINS=https://yourdomain.com
